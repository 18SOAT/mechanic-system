// =============================================================
// mechanic-system — persistence schema
//
// - IDs: UUID v7 generated in the domain (IdGenerator) → no @default.
// - Money: Decimal(10,2), never Float.
// - Database in snake_case (@@map/@map), code in camelCase.
// - Across different aggregates the domain references by ID only;
//   FKs exist for referential integrity, not for navigation.
// =============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// Identity (login for customers and employees)
// -------------------------------------------------------------

enum UserType {
  CUSTOMER
  EMPLOYEE
}

model User {
  id             String   @id @db.Uuid
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  type           UserType
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer Customer?
  employee Employee?

  @@map("users")
}

enum EmployeeRole {
  ADMIN
  MECHANIC
}

model Employee {
  id        String       @id @db.Uuid
  userId    String       @unique @map("user_id") @db.Uuid
  name      String
  role      EmployeeRole
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user                  User                        @relation(fields: [userId], references: [id])
  assignedServiceOrders ServiceOrder[]
  statusChanges         ServiceOrderStatusHistory[]

  @@map("employees")
}

// -------------------------------------------------------------
// Customers and Vehicles
// -------------------------------------------------------------

model Customer {
  id        String   @id @db.Uuid
  userId    String?  @unique @map("user_id") @db.Uuid // login is optional
  name      String
  document  String   @unique // CPF (11) or CNPJ (14), digits only — VO Document
  email     String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id])
  vehicles Vehicle[]
  orders   Order[]

  @@map("customers")
}

model Vehicle {
  id         String   @id @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  plate      String   @unique // uppercase, no hyphen — VO LicensePlate
  brand      String
  model      String
  year       Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])
  orders   Order[]

  @@index([customerId])
  @@map("vehicles")
}

// -------------------------------------------------------------
// Catalog: Services and Products (parts/supplies) + stock
// -------------------------------------------------------------

model Service {
  id                        String   @id @db.Uuid
  name                      String   @unique
  description               String?
  price                     Decimal  @db.Decimal(10, 2)
  estimatedDurationMinutes  Int?     @map("estimated_duration_minutes")
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  items ServiceItem[]

  @@map("services")
}

enum ProductType {
  PART
  SUPPLY
}

// Stock and sale are always in whole units (e.g. one 500ml oil bottle — the size goes in the description).
model Product {
  id            String      @id @db.Uuid
  sku           String      @unique
  name          String
  description   String?
  type          ProductType
  price         Decimal     @db.Decimal(10, 2) // price per unit
  stockQuantity Int         @default(0) @map("stock_quantity")
  minimumStock  Int         @default(0) @map("minimum_stock")
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  items          ProductItem[]
  stockMovements StockMovement[]

  @@map("products")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

// Stock ledger: every change to Product.stockQuantity writes one row here.
model StockMovement {
  id             String            @id @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  type           StockMovementType
  quantity       Int
  reason         String?
  serviceOrderId String?           @map("service_order_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")

  product      Product       @relation(fields: [productId], references: [id])
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  @@index([productId])
  @@index([serviceOrderId])
  @@map("stock_movements")
}

// -------------------------------------------------------------
// Order (vehicle stay, aggregate root) → Service Orders → Items
// -------------------------------------------------------------

enum OrderStatus {
  RECEIVED
  IN_PROGRESS
  DELIVERED
}

// From the vehicle's arrival to its delivery. Groups every service order of the stay.
model Order {
  id          String      @id @db.Uuid
  number      Int         @unique @default(autoincrement()) // human-readable
  customerId  String      @map("customer_id") @db.Uuid
  vehicleId   String      @map("vehicle_id") @db.Uuid
  status      OrderStatus @default(RECEIVED)
  notes       String?
  receivedAt  DateTime    @default(now()) @map("received_at")
  deliveredAt DateTime?   @map("delivered_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  customer      Customer       @relation(fields: [customerId], references: [id])
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id])
  serviceOrders ServiceOrder[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@map("orders")
}

enum ServiceOrderStatus {
  IN_DIAGNOSIS
  AWAITING_APPROVAL // quote phase
  REJECTED
  IN_EXECUTION
  FINISHED
}

// Born as a quote; once approved, the amount is frozen and it becomes a real service order.
model ServiceOrder {
  id             String             @id @db.Uuid
  orderId        String             @map("order_id") @db.Uuid
  assigneeId     String?            @map("assignee_id") @db.Uuid // mechanic
  status         ServiceOrderStatus // current status (mirrors the latest history row)
  description    String?
  approvedAmount Decimal?           @map("approved_amount") @db.Decimal(10, 2)
  approvedAt     DateTime?          @map("approved_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  order          Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignee       Employee?                   @relation(fields: [assigneeId], references: [id])
  services       ServiceItem[]
  products       ProductItem[]
  statusHistory  ServiceOrderStatusHistory[]
  stockMovements StockMovement[]

  @@index([orderId])
  @@index([status])
  @@map("service_orders")
}

// Price is a snapshot taken when the quote is built — catalog changes don't touch old orders.
model ServiceItem {
  id             String  @id @db.Uuid
  serviceOrderId String  @map("service_order_id") @db.Uuid
  serviceId      String  @map("service_id") @db.Uuid
  quantity       Int     @default(1)
  unitPrice      Decimal @map("unit_price") @db.Decimal(10, 2)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id])

  @@index([serviceOrderId])
  @@map("service_items")
}

model ProductItem {
  id             String  @id @db.Uuid
  serviceOrderId String  @map("service_order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Int // whole units sold (e.g. 4 gallons)
  unitPrice      Decimal @map("unit_price") @db.Decimal(10, 2)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([serviceOrderId])
  @@map("product_items")
}

// Every transition is a new row (append-only).
model ServiceOrderStatusHistory {
  id             String             @id @db.Uuid
  serviceOrderId String             @map("service_order_id") @db.Uuid
  status         ServiceOrderStatus
  changedById    String?            @map("changed_by_id") @db.Uuid // null = customer/system
  changedAt      DateTime           @default(now()) @map("changed_at")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  changedBy    Employee?    @relation(fields: [changedById], references: [id])

  @@index([serviceOrderId, changedAt])
  @@map("service_order_status_history")
}
